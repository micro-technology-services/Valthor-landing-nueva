---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaPair from '../components/CtaPair.astro';
---

<BaseLayout title="Página no encontrada · Valthor" description="La página que buscás no existe o cambió de dirección." noindex>
  <section class="nf">
    <div class="wrap inner">
      <p class="eyebrow">Error 404</p>
      <h1>No encontramos esta página</h1>
      <p class="lead">Puede que haya cambiado de dirección. Estas te pueden servir:</p>
      <ul class="links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/funciones/agente-ia-whatsapp">Agente de IA para WhatsApp</a></li>
        <li><a href="/planes">Planes</a></li>
        <li><a href="/preguntas-frecuentes">Preguntas frecuentes</a></li>
      </ul>
      <CtaPair location="404" center />
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: 160px 0 110px;
    background:
      radial-gradient(900px 500px at 50% 0%, rgba(139, 92, 246, 0.28), transparent 60%),
      var(--bg);
    text-align: center;
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(34px, 5vw, 52px);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 24px;
  }
  .links a {
    color: var(--accent-soft);
    font-weight: 600;
  }
</style>
