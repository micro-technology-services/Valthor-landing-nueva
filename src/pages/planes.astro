---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { breadcrumbs, faqPage, webPage } from '../lib/schema';

const p = (await getEntry('plans', 'planes'))!.data;
const crumbs = [{ name: 'Planes', path: '/planes' }];
const faqs = p.faqs.map((f, i) => ({ id: `planes-${i + 1}`, ...f }));
---

<BaseLayout
  title={p.seo.title}
  description={p.seo.description}
  jsonLd={[webPage({ path: '/planes', name: p.h1, description: p.seo.description }), breadcrumbs(crumbs), faqPage(p.faqs)]}
>
  <PageHero crumbs={crumbs} eyebrow={p.eyebrow} h1={p.h1} intro={p.intro} />

  <section class="section lavender plans" aria-labelledby="plans-title">
    <div class="wrap">
      <h2 id="plans-title" class="sr-only">Qué incluye cada plan</h2>
      <ul class="grid">
        {
          p.plans.map((plan) => (
            <li class:list={['plan', plan.featured && 'featured']}>
              <h3>{plan.name}</h3>
              <p class="tagline">{plan.tagline}</p>
              <p class="biz">{plan.businesses}</p>
              <ul class="incl">
                {plan.includes.map((i) => (
                  <li>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                    {i.text}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <div class="all">
        <h3>{p.allPlans.title}</h3>
        <ul>
          {p.allPlans.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section faq-sec" aria-labelledby="faq-title">
    <div class="wrap faq-inner">
      <h2 id="faq-title" class="h2">Preguntas sobre los planes</h2>
      <FaqList faqs={faqs} />
    </div>
  </section>

  <RelatedLinks
    items={[
      { title: 'Agente de IA para WhatsApp', text: 'Qué hace el agente en cada conversación.', href: '/funciones/agente-ia-whatsapp' },
      { title: 'CRM para WhatsApp', text: 'Contactos, ventas y seguimiento.', href: '/funciones/crm-whatsapp' },
      { title: 'Preguntas frecuentes', text: 'Todo lo que suelen preguntarnos.', href: '/preguntas-frecuentes' },
    ]}
  />

  <CtaBand title={p.cta.title} text={p.cta.text} location="planes-final" />
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
    align-items: stretch;
  }
  .plan {
    background: #fff;
    border: 1px solid var(--line-light);
    border-radius: 22px;
    padding: 32px 28px;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .plan.featured {
    border: 2px solid var(--accent-ink);
    box-shadow: 0 20px 50px rgba(124, 58, 237, 0.18);
  }
  .plan h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
  }
  .tagline {
    color: var(--ink-2);
    font-size: 16px;
  }
  .biz {
    align-self: flex-start;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-ink);
    background: rgba(124, 58, 237, 0.1);
    padding: 4px 11px;
    border-radius: 999px;
    margin-bottom: 8px;
  }
  .incl {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--line-light);
    padding-top: 18px;
  }
  .incl li {
    display: flex;
    gap: 10px;
    font-size: 15px;
    line-height: 1.45;
  }
  .incl svg {
    flex: none;
    color: #047857;
    margin-top: 2px;
  }
  .all {
    margin-top: 32px;
    background: #fff;
    border: 1px solid var(--line-light);
    border-radius: 20px;
    padding: 26px 28px;
  }
  .all h3 {
    font-family: var(--font-display);
    font-size: 20px;
    margin-bottom: 12px;
  }
  .all ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-size: 15px;
    color: var(--ink-2);
  }
  .all li::before {
    content: '✓ ';
    color: #047857;
    font-weight: 700;
  }
  .faq-sec {
    background: var(--bg);
  }
  .faq-inner {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
</style>
