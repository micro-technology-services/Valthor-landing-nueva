---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbs } from '../lib/schema';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((page) => ({ params: { legal: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const crumbs = [{ name: page.data.title, path: `/${page.id}` }];
---

<BaseLayout title={page.data.seo.title} description={page.data.seo.description} jsonLd={[breadcrumbs(crumbs)]}>
  <article class="legal">
    <header class="wrap head">
      <Breadcrumbs items={crumbs} />
      <h1>{page.data.title}</h1>
      <p class="updated">Última actualización: {page.data.updated}</p>
    </header>
    <div class="wrap body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    padding: 140px 0 96px;
    background:
      radial-gradient(900px 420px at 70% -10%, rgba(139, 92, 246, 0.22), transparent 60%),
      var(--bg);
  }
  .head,
  .body {
    max-width: 820px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 5vw, 46px);
    letter-spacing: -0.02em;
    margin-top: 18px;
  }
  .updated {
    margin-top: 8px;
    color: var(--on-dark-3);
    font-size: 14px;
  }
  .body {
    margin-top: 12px;
    color: var(--on-dark-2);
    font-size: 16px;
    line-height: 1.7;
  }
  .body :global(h2) {
    font-family: var(--font-display);
    color: #fff;
    font-size: 21px;
    margin: 36px 0 10px;
  }
  .body :global(ul) {
    list-style: disc;
    padding-left: 22px;
  }
  .body :global(li + li) {
    margin-top: 6px;
  }
  .body :global(strong) {
    color: #fff;
  }
  .body :global(a) {
    color: var(--accent-soft);
  }
  @media (max-width: 720px) {
    .legal {
      padding-top: 104px;
    }
  }
</style>
