---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TutorialCard from '../../components/tutoriales/TutorialCard.astro';
import { breadcrumbs, webPage } from '../../lib/schema';
import { CATEGORIES, getTutoriales, tutorialPath } from '../../lib/tutoriales';

const SITE = 'https://www.valthor.app';
const title = 'Tutoriales de Valthor | Guías de IA para PyMEs y e-commerce';
const description =
  'Aprende a sacarle el máximo a Valthor y a la IA en tu negocio: guías paso a paso, prompts listos y herramientas que puedes usar hoy en tu PyME.';
const crumbs = [{ name: 'Tutoriales', path: '/tutoriales' }];

const all = await getTutoriales();
const featured = all.find((t) => t.data.featured);
const rest = all.filter((t) => t !== featured);
const filters = [{ key: 'todos', label: 'Todos' }, ...Object.entries(CATEGORIES).map(([key, label]) => ({ key, label }))];

const itemList = {
  '@type': 'ItemList',
  itemListElement: all.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE}${tutorialPath(t)}`, name: t.data.title })),
};
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={[webPage({ path: '/tutoriales', name: 'Tutoriales', description }), breadcrumbs(crumbs), ...(all.length ? [itemList] : [])]}
>
  <section class="tut-hero" aria-labelledby="page-title">
    <div class="wrap inner">
      <Breadcrumbs items={crumbs} />
      <h1 id="page-title">Tutoriales</h1>
      <p class="intro">
        Aprende a sacarle el máximo a Valthor y a la IA en tu negocio. Guías paso a paso, prompts listos y herramientas que
        puedes usar hoy.
      </p>
    </div>
  </section>

  <section class="light listing" aria-label="Lista de tutoriales">
    <div class="wrap">
      {
        all.length > 0 && (
          <div class="controls" data-tut-controls>
            <div class="chips" role="group" aria-label="Filtrar por categoría">
              {filters.map((f) => (
                <button type="button" class="chip" data-cat-filter={f.key} aria-pressed={f.key === 'todos' ? 'true' : 'false'}>
                  {f.label}
                </button>
              ))}
            </div>
            <div class="search">
              <label for="tut-search" class="sr-only">
                Buscar tutoriales
              </label>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
              <input id="tut-search" type="search" placeholder="Buscar por tema, herramienta o etiqueta" autocomplete="off" data-tut-search />
            </div>
          </div>
        )
      }
      <p class="sr-only" aria-live="polite" data-tut-count></p>

      {
        featured && (
          <div class="featured-wrap">
            <TutorialCard tutorial={featured} featured headingLevel="h2" />
          </div>
        )
      }

      {
        rest.length > 0 && (
          <ul class="grid" role="list">
            {rest.map((t) => (
              <li>
                <TutorialCard tutorial={t} headingLevel="h2" />
              </li>
            ))}
          </ul>
        )
      }

      <div class="empty" data-tut-empty hidden={all.length > 0}>
        <h2 class="empty-title">{all.length ? 'No encontramos tutoriales con ese filtro' : 'Muy pronto, las primeras guías'}</h2>
        <p>
          {
            all.length
              ? 'Prueba con otra palabra o vuelve a ver todos los tutoriales.'
              : 'Estamos preparando guías paso a paso para que le saques el máximo a Valthor y a la IA en tu negocio.'
          }
        </p>
        {
          all.length > 0 && (
            <button type="button" class="reset" data-tut-reset>
              Ver todos los tutoriales
            </button>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Client-side filters: category chips (synced to ?cat=) and text search.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tutorial]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-cat-filter]')];
  const input = document.querySelector<HTMLInputElement>('[data-tut-search]');
  const empty = document.querySelector<HTMLElement>('[data-tut-empty]');
  const count = document.querySelector<HTMLElement>('[data-tut-count]');
  const reset = document.querySelector<HTMLButtonElement>('[data-tut-reset]');
  const valid = new Set(chips.map((c) => c.dataset.catFilter));

  const normalize = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  let cat = new URLSearchParams(location.search).get('cat') ?? 'todos';
  if (!valid.has(cat)) cat = 'todos';

  function apply(updateUrl: boolean) {
    const q = normalize(input?.value.trim() ?? '');
    let visible = 0;
    for (const card of cards) {
      const show = (cat === 'todos' || card.dataset.cat === cat) && (!q || normalize(card.dataset.search ?? '').includes(q));
      // Hide the list item (or the featured wrapper) so the grid has no gaps.
      const box = card.closest('li') ?? card.parentElement!;
      box.hidden = !show;
      if (show) visible++;
    }
    for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.catFilter === cat));
    if (empty && cards.length) empty.hidden = visible > 0;
    if (count && cards.length) count.textContent = visible === 1 ? '1 tutorial' : `${visible} tutoriales`;
    if (updateUrl) {
      const url = new URL(location.href);
      if (cat === 'todos') url.searchParams.delete('cat');
      else url.searchParams.set('cat', cat);
      history.replaceState(null, '', url);
    }
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      cat = chip.dataset.catFilter ?? 'todos';
      apply(true);
    }),
  );
  input?.addEventListener('input', () => apply(false));
  reset?.addEventListener('click', () => {
    cat = 'todos';
    if (input) input.value = '';
    apply(true);
    chips[0]?.focus();
  });
  if (cards.length) apply(false);
</script>

<style>
  .tut-hero {
    padding: 140px 0 64px;
    background:
      radial-gradient(1100px 600px at 75% -10%, rgba(139, 92, 246, 0.28), transparent 60%),
      radial-gradient(800px 500px at 0% 40%, rgba(217, 70, 239, 0.12), transparent 55%),
      var(--bg);
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .intro {
    font-size: 19px;
    line-height: 1.6;
    color: var(--on-dark-2);
    max-width: 760px;
  }
  .listing {
    padding: 48px 0 96px;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid rgba(124, 58, 237, 0.3);
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .chip:hover {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }
  .chip[aria-pressed='true'] {
    background: var(--accent-ink);
    border-color: var(--accent-ink);
    color: #fff;
  }
  .search {
    position: relative;
    flex: 0 1 360px;
    min-width: 240px;
  }
  .search svg {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted-light);
    pointer-events: none;
  }
  .search input {
    width: 100%;
    min-height: 44px;
    padding: 0 14px 0 42px;
    border-radius: 12px;
    border: 1px solid #d9dce6;
    background: #fff;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
  }
  .search input::placeholder {
    color: var(--muted-light);
  }
  .search input:focus-visible {
    outline: 3px solid var(--accent-ink);
    outline-offset: 1px;
    border-radius: 12px;
  }
  .featured-wrap {
    margin-bottom: 24px;
  }
  .featured-wrap[hidden],
  .grid li[hidden] {
    display: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
  .grid li {
    display: flex;
  }
  .grid li > :global(*) {
    flex: 1;
  }
  .empty {
    text-align: center;
    padding: 64px 24px;
    border: 1px dashed #d9dce6;
    border-radius: 18px;
    color: var(--ink-2);
  }
  .empty[hidden] {
    display: none;
  }
  .empty-title {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .reset {
    margin-top: 18px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 12px;
    border: 1px solid rgba(124, 58, 237, 0.45);
    background: #fff;
    color: var(--accent-ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  @media (max-width: 720px) {
    .tut-hero {
      padding: 104px 0 44px;
    }
    .intro {
      font-size: 17px;
    }
    .search {
      flex: 1 1 100%;
    }
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
