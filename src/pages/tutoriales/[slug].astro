---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cta from '../../components/Cta.astro';
import TutorialCard from '../../components/tutoriales/TutorialCard.astro';
import { breadcrumbs } from '../../lib/schema';
import {
  CATEGORIES,
  LEAD_WEBHOOK_URL,
  VALTHOR_WHATSAPP_NUMBER,
  formatDate,
  getTutoriales,
  relatedTutorials,
  transformBody,
  tutorialJsonLd,
  tutorialPath,
  videoEmbed,
  videoHtml,
  type Tutorial,
} from '../../lib/tutoriales';

export async function getStaticPaths() {
  const all = await getTutoriales();
  return all.map((tutorial) => ({ params: { slug: tutorial.data.slug }, props: { tutorial, all } }));
}

interface Props {
  tutorial: Tutorial;
  all: Tutorial[];
}
const { tutorial, all } = Astro.props;
const d = tutorial.data;
const path = tutorialPath(tutorial);
const body = await transformBody(tutorial.rendered?.html ?? '');
const gated = d.gated && body.after.trim() !== '';
const related = relatedTutorials(tutorial, all);
const ogImage = d.cover ?? '/og/valthor.png';
const crumbs = [
  { name: 'Tutoriales', path: '/tutoriales' },
  { name: d.title, path },
];

// Frontmatter video: shown at the top unless the body already embeds it.
const topVideo = d.video && !body.embedded.includes(d.video) ? videoEmbed(d.video) : null;

const resourceName = (() => {
  if (!d.resourceUrl) return '';
  const host = new URL(d.resourceUrl).hostname;
  if (host.includes('github')) return 'Abrir en GitHub';
  if (host.includes('drive.google') || host.includes('docs.google')) return 'Abrir en Google Drive';
  if (host.includes('notion')) return 'Abrir en Notion';
  return 'Abrir recurso';
})();
const hasFicha = Boolean((d.specs && Object.keys(d.specs).length) || d.resourceUrl);

const waHref = `https://wa.me/${VALTHOR_WHATSAPP_NUMBER}?text=${encodeURIComponent(`Hola, quiero la guía: ${d.title}`)}`;
const isoDate = d.date.toISOString().slice(0, 10);
---

<BaseLayout
  title={`${d.title} | Tutoriales Valthor`}
  description={d.description}
  ogImage={ogImage}
  ogImageAlt={d.cover ? (d.coverAlt ?? d.title) : undefined}
  ogType="article"
  noindex={d.draft}
  jsonLd={[breadcrumbs(crumbs), ...tutorialJsonLd(tutorial, body, ogImage)]}
>
  <section class="tut-hero" aria-labelledby="page-title">
    <div class="wrap hero-inner">
      <Breadcrumbs items={crumbs} showHome={false} />
      <p class="badges">
        <a class="badge" href={`/tutoriales?cat=${d.category}`}>{CATEGORIES[d.category]}</a>
        {d.draft && <span class="badge badge-draft">Borrador</span>}
      </p>
      <h1 id="page-title">{d.title}</h1>
      <p class="desc">{d.description}</p>

      <div class="en-corto" role="note" aria-labelledby="en-corto-title">
        <p id="en-corto-title" class="en-corto-title">En corto</p>
        <p>{d.summary}</p>
      </div>

      <ul class="meta" aria-label="Datos del tutorial">
        <li><span class="k">Nivel</span> {d.level}</li>
        <li><span class="k">Duración</span> {d.duration}</li>
        <li><span class="k">Fecha</span> <time datetime={isoDate}>{formatDate(d.date)}</time></li>
        <li><span class="k">Autor</span> {d.author}</li>
        {
          d.socialUrl && (
            <li>
              <a class="social" href={d.socialUrl} rel="noopener" target="_blank">
                Visto en Instagram<span class="sr-only"> (se abre en otra pestaña)</span>
              </a>
            </li>
          )
        }
      </ul>
      {
        d.tags.length > 0 && (
          <ul class="tags" aria-label="Etiquetas">
            {d.tags.map((t) => (
              <li>#{t}</li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <div class="light article-area">
    <div class="wrap layout">
      {
        body.toc.length > 0 && (
          <aside class="toc-col">
            <nav class="toc" aria-labelledby="toc-title">
              <p id="toc-title" class="toc-title">Ir directo a</p>
              <ol>
                {body.toc.map((s) => (
                  <li>
                    <a href={`#${s.id}`} data-toc-link>
                      <span class="toc-num" aria-hidden="true">
                        {s.num}
                      </span>
                      {s.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }

      <article class="content" aria-labelledby="page-title">
        {
          hasFicha && (
            <section class="ficha" aria-labelledby="ficha-title">
              <h2 id="ficha-title" class="ficha-title">
                Ficha
              </h2>
              <dl>
                {Object.entries(d.specs ?? {}).map(([k, v]) => (
                  <div>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
                {d.resourceUrl && (
                  <div>
                    <dt>Material de apoyo</dt>
                    <dd>
                      <a href={d.resourceUrl} rel="noopener" target="_blank">
                        {resourceName}
                        <span class="sr-only"> (se abre en otra pestaña)</span>
                      </a>
                    </dd>
                  </div>
                )}
              </dl>
            </section>
          )
        }

        {topVideo && <Fragment set:html={videoHtml(topVideo, d.title)} />}

        <div class="prose" set:html={body.before} />

        {
          gated ? (
            <>
              {/*
                Client-side gate, on purpose: the full guide stays in the static
                HTML so search engines and AI assistants can index it (declared
                as gated content in the JSON-LD with isAccessibleForFree=false
                and cssSelector ".gate-rest", Google's markup for paywalled
                content). The blur only asks visitors for their contact; it is
                not meant to protect the content.
              */}
              <div
                class="gate is-locked"
                data-gate
                data-slug={d.slug}
                data-title={d.title}
                data-webhook={LEAD_WEBHOOK_URL}
                data-dev={import.meta.env.DEV ? 'true' : 'false'}
              >
                <p class="gate-done" data-gate-done tabindex="-1" hidden>
                  Listo, ya tienes la guía completa.
                </p>
                <div class="prose gate-rest" data-gate-rest inert>
                  <Fragment set:html={body.after} />
                </div>
                <section class="gate-card" data-gate-card aria-labelledby="gate-title">
                  <h2 id="gate-title" class="gate-title">
                    Desbloquea la guía completa
                  </h2>
                  <p class="gate-text">Recíbela en tu WhatsApp o déjanos tu nombre y correo para verla aquí mismo.</p>
                  <a
                    class="btn btn-primary btn-lg gate-wa"
                    href={waHref}
                    rel="noopener"
                    data-track="whatsapp_click"
                    data-track-location="tutorial-gate"
                  >
                    Recíbela por WhatsApp
                  </a>
                  <p class="gate-or">
                    <span>o</span>
                  </p>
                  <form class="gate-form" data-gate-form novalidate>
                    <div class="field">
                      <label for="gate-name">Nombre</label>
                      <input id="gate-name" name="name" type="text" autocomplete="name" required />
                    </div>
                    <div class="field">
                      <label for="gate-email">Correo electrónico</label>
                      <input id="gate-email" name="email" type="email" autocomplete="email" inputmode="email" required />
                    </div>
                    <div class="field">
                      <label for="gate-phone">
                        WhatsApp <span class="optional">(opcional)</span>
                      </label>
                      <input
                        id="gate-phone"
                        name="phone"
                        type="tel"
                        autocomplete="tel"
                        inputmode="tel"
                        aria-describedby="gate-phone-hint"
                      />
                      <p id="gate-phone-hint" class="hint">Con código de país, por ejemplo +54 9 11 1234 5678.</p>
                    </div>
                    <label class="consent" for="gate-consent">
                      <input id="gate-consent" name="consent" type="checkbox" value="1" />
                      <span>Acepto que me contacten por WhatsApp</span>
                    </label>
                    <button type="submit" class="gate-submit">
                      Ver la guía completa
                    </button>
                    <p class="gate-status" data-gate-status role="status" aria-live="polite" />
                    <p class="gate-legal">
                      Usamos tus datos solo para enviarte esta guía y novedades de Valthor. Lee la{' '}
                      <a href="/privacidad">política de privacidad</a>.
                    </p>
                  </form>
                </section>
              </div>
              <noscript>
                <style is:inline>
                  .gate-rest { max-height: none !important; filter: none !important; -webkit-mask-image: none !important; mask-image: none !important; }
                  .gate-card { display: none !important; }
                </style>
              </noscript>
            </>
          ) : (
            body.after && <div class="prose" set:html={body.after} />
          )
        }
      </article>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="section lavender related" aria-labelledby="related-title">
        <div class="wrap">
          <h2 id="related-title" class="related-title">
            Tutoriales relacionados
          </h2>
          <ul class="related-grid" role="list">
            {related.map((t) => (
              <li>
                <TutorialCard tutorial={t} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section closing" aria-labelledby="closing-title">
    <div class="wrap closing-inner">
      <h2 id="closing-title" class="h2">¿Quieres que Valthor atienda, venda y cobre por tu negocio?</h2>
      <Cta kind="demo" size="lg" label="Agendar demo" location="tutorial-closing" />
    </div>
  </section>
</BaseLayout>

<script>
  // Copy buttons on code and prompt blocks.
  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.append(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]');
    const aria = btn.getAttribute('aria-label') ?? 'Copiar';
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      const target = document.getElementById(btn.dataset.copy ?? '');
      if (!target) return;
      const ok = await copyText((target.textContent ?? '').replace(/\n$/, ''));
      if (!label) return;
      label.textContent = ok ? '¡Copiado!' : 'No se pudo copiar';
      btn.setAttribute('aria-label', ok ? '¡Copiado!' : 'No se pudo copiar');
      btn.classList.toggle('copied', ok);
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = 'Copiar';
        btn.setAttribute('aria-label', aria);
        btn.classList.remove('copied');
      }, 2000);
    });
  });

  // Click-to-load videos: the iframe is created only when the visitor presses play.
  document.querySelectorAll<HTMLButtonElement>('[data-embed-src]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.embedSrc!;
      iframe.title = btn.dataset.embedTitle ?? 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      btn.replaceWith(iframe);
      iframe.focus();
    });
  });

  // Highlight the current section in «Ir directo a».
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          byId.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    byId.forEach((_a, id) => {
      const h = document.getElementById(id);
      if (h) io.observe(h);
    });
  }

  // Gate (only on tutorials with gated: true).
  const gate = document.querySelector<HTMLElement>('[data-gate]');
  if (gate) {
    const slug = gate.dataset.slug ?? '';
    const title = gate.dataset.title ?? slug;
    const webhook = gate.dataset.webhook ?? '';
    const isDev = gate.dataset.dev === 'true';
    const key = `valthor:tutoriales:desbloqueado:${slug}`;
    const rest = gate.querySelector<HTMLElement>('[data-gate-rest]')!;
    const card = gate.querySelector<HTMLElement>('[data-gate-card]')!;
    const done = gate.querySelector<HTMLElement>('[data-gate-done]')!;
    const form = gate.querySelector<HTMLFormElement>('[data-gate-form]')!;
    const status = gate.querySelector<HTMLElement>('[data-gate-status]')!;

    const remember = () => {
      try {
        localStorage.setItem(key, '1');
      } catch {
        // Private mode or storage disabled: the guide stays unlocked for this visit only.
      }
    };
    const unlock = (announce: boolean) => {
      gate.classList.remove('is-locked');
      rest.inert = false;
      card.hidden = true;
      if (announce) {
        done.hidden = false;
        done.focus();
      }
    };

    try {
      if (localStorage.getItem(key) === '1') unlock(false);
    } catch {
      // Storage not available: keep the gate.
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      // Keep the leading + and the digits; spaces, dashes and parentheses go.
      const phone = String(data.get('phone') ?? '')
        .trim()
        .replace(/(?!^\+)[^\d]/g, '');
      const consent = data.get('consent') === '1';
      const nameInput = form.elements.namedItem('name') as HTMLInputElement;
      const emailInput = form.elements.namedItem('email') as HTMLInputElement;
      const phoneInput = form.elements.namedItem('phone') as HTMLInputElement;
      nameInput.removeAttribute('aria-invalid');
      emailInput.removeAttribute('aria-invalid');
      phoneInput.removeAttribute('aria-invalid');
      if (!name) {
        nameInput.setAttribute('aria-invalid', 'true');
        status.textContent = 'Escribe tu nombre.';
        nameInput.focus();
        return;
      }
      if (!emailInput.checkValidity() || !email) {
        emailInput.setAttribute('aria-invalid', 'true');
        status.textContent = 'Revisa tu correo electrónico.';
        emailInput.focus();
        return;
      }
      const digits = phone.replace(/\D/g, '').length;
      if ((phone && (digits < 8 || digits > 15)) || (consent && !phone)) {
        phoneInput.setAttribute('aria-invalid', 'true');
        status.textContent = phone
          ? 'Revisa tu WhatsApp: escríbelo con código de país.'
          : 'Escribe tu WhatsApp para que podamos contactarte por ahí.';
        phoneInput.focus();
        return;
      }

      if (!webhook) {
        console.warn('[tutoriales] LEAD_WEBHOOK_URL no está configurada: el formulario no envía los datos a ningún lado.');
        if (isDev) {
          remember();
          unlock(true);
        } else {
          status.textContent = 'No pudimos registrar tus datos. Prueba con el botón de WhatsApp.';
        }
        return;
      }

      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      submit.disabled = true;
      status.textContent = 'Enviando…';
      try {
        const res = await fetch(webhook, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          // `telefono`, `consent`, `mensaje` and `utm_campaign` are the field
          // names Valthor's own web forms read (/api/public/forms/{token}): the
          // contact gets the WhatsApp number, the WhatsApp consent (without it
          // Valthor never enrolls the contact in WhatsApp automations), the
          // guide requested and where it came from.
          body: JSON.stringify({
            name,
            email,
            ...(phone ? { telefono: phone } : {}),
            consent,
            tutorialSlug: slug,
            source: 'tutoriales',
            mensaje: `Pidió la guía: ${title}`,
            utm_campaign: 'tutoriales',
          }),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        status.textContent = '';
        remember();
        unlock(true);
        const w = window as unknown as { gtag?: (...args: unknown[]) => void };
        w.gtag?.('event', 'generate_lead', { lead_source: 'tutoriales', tutorial_slug: slug });
      } catch (err) {
        console.error('[tutoriales] No se pudo enviar el formulario', err);
        status.textContent = 'No pudimos registrar tus datos. Inténtalo de nuevo o usa el botón de WhatsApp.';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .tut-hero {
    padding: 132px 0 56px;
    background:
      radial-gradient(1100px 600px at 75% -10%, rgba(139, 92, 246, 0.28), transparent 60%),
      radial-gradient(800px 500px at 0% 40%, rgba(217, 70, 239, 0.12), transparent 55%),
      var(--bg);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    max-width: calc(880px + 2 * var(--gutter));
    margin-left: max(0px, calc((100% - var(--wrap)) / 2));
  }
  .badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .badge {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.18);
    color: var(--accent-soft);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }
  a.badge:hover {
    background: rgba(139, 92, 246, 0.3);
    color: #fff;
  }
  .badge-draft {
    background: #fff3d6;
    color: #8a5a00;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 4.6vw, 52px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .desc {
    font-size: 19px;
    line-height: 1.6;
    color: var(--on-dark-2);
    max-width: 760px;
  }
  .en-corto {
    width: 100%;
    max-width: 760px;
    padding: 18px 22px;
    border-radius: 14px;
    border: 1px solid rgba(167, 139, 250, 0.35);
    background: rgba(139, 92, 246, 0.1);
    font-size: 16px;
    line-height: 1.6;
    color: var(--on-dark);
  }
  .en-corto-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-soft);
    margin-bottom: 6px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 14px;
    color: var(--on-dark-2);
  }
  .meta .k {
    color: var(--on-dark-3);
    margin-right: 4px;
  }
  .social {
    color: var(--accent-soft);
    font-weight: 600;
  }
  .social:hover {
    color: #fff;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-dark);
    font-size: 13px;
    color: var(--on-dark-2);
  }

  /* Article: TOC sidebar + content. No overflow:hidden here, or the sticky TOC stops working. */
  .article-area {
    padding: 56px 0 88px;
  }
  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .content {
    max-width: 760px;
    min-width: 0;
  }
  .content:only-child {
    grid-column: 1 / -1;
    margin: 0 auto;
  }
  .toc-col {
    position: sticky;
    top: 24px;
  }
  .toc {
    padding: 18px;
    border-radius: 14px;
    border: 1px solid var(--line-light);
    background: #fafafe;
  }
  .toc-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: 10px;
  }
  .toc li + li {
    margin-top: 2px;
  }
  .toc a {
    display: flex;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink-2);
    text-decoration: none;
  }
  .toc a:hover {
    background: var(--lavender);
    color: var(--ink);
  }
  .toc a[aria-current='true'] {
    background: var(--lavender);
    color: var(--accent-ink);
    font-weight: 700;
  }
  .toc-num {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
  }

  .ficha {
    margin-bottom: 36px;
    padding: 22px 24px;
    border-radius: 14px;
    border: 1px solid var(--line-light);
    background: #fafafe;
  }
  .ficha-title {
    font-family: var(--font-display);
    font-size: 20px;
    margin-bottom: 12px;
  }
  .ficha dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px 24px;
  }
  .ficha dt {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-light);
  }
  .ficha dd {
    margin-top: 2px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink);
  }
  .ficha a {
    color: var(--accent-ink);
    font-weight: 600;
  }

  /* Markdown body */
  .prose {
    font-size: 17px;
    line-height: 1.75;
    color: #2b3240;
    counter-reset: none;
  }
  .prose > :global(* + *) {
    margin-top: 1.1em;
  }
  .prose :global(h2) {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-top: 2.2em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    scroll-margin-top: 24px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(.h2-num) {
    flex: none;
    font-size: 16px;
    padding: 4px 8px;
    border-radius: 8px;
    background: var(--lavender);
    color: var(--accent-ink);
    font-variant-numeric: tabular-nums;
