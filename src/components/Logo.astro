---
import { Image } from 'astro:assets';
import icon from '../assets/brand/valthor-icon.png';

interface Props {
  size?: 'md' | 'sm';
}
const { size = 'md' } = Astro.props;
const h = size === 'md' ? 46 : 38;
---

<span class:list={['logo', size]}>
  <Image src={icon} alt="" height={h} width={Math.round((h * icon.width) / icon.height)} densities={[1, 2]} loading="eager" />
  <span class="words"><span class="name">VALTHOR</span><span class="by">by MTS</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }
  .logo img {
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }
  a:hover .logo img {
    transform: scale(1.1);
    filter: drop-shadow(0 0 22px rgba(217, 70, 239, 0.9)) brightness(1.3);
  }
  .words {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-display);
  }
  .name {
    font-weight: 700;
    font-size: 21px;
    letter-spacing: 0.16em;
    color: #fff;
  }
  .by {
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.34em;
    color: var(--accent-soft);
    margin-top: 5px;
  }
  .sm .name {
    font-size: 17px;
  }
  .sm .by {
    font-size: 9px;
  }
</style>
