---
// Final CTA section of inner pages: the only place with the booking link.
import CtaPair from './CtaPair.astro';
interface Props {
  title: string;
  text: string;
  location: string;
}
const { title, text, location } = Astro.props;
---

<section class="section cta-band" aria-labelledby={`cta-${location}`}>
  <div class="wrap inner">
    <h2 id={`cta-${location}`} class="h2">{title}</h2>
    <p class="lead">{text}</p>
    <CtaPair location={location} size="lg" center withBooking />
  </div>
</section>

<style>
  .cta-band {
    background:
      radial-gradient(900px 500px at 50% 0%, rgba(139, 92, 246, 0.3), transparent 60%),
      var(--bg);
    text-align: center;
  }
  .inner {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
</style>
