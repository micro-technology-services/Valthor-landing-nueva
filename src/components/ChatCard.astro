---
// WhatsApp-style example conversation (light card on dark sections).
interface Props {
  label: string;
  business: string;
  messages: { from: 'client' | 'ai'; text?: string; audio?: string }[];
  caption?: string;
}
const { label, business, messages, caption = 'Conversación de ejemplo' } = Astro.props;
---

<figure class="chat-card" aria-label={label}>
  <div class="head">
    <span class="av" aria-hidden="true"></span>
    <span class="who"><strong>{business}</strong><span>WhatsApp · en línea</span></span>
  </div>
  <div class="body">
    {
      messages.map((m) =>
        m.audio ? (
          <p class="msg in audio">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
            <span class="wave" aria-hidden="true" />
            {m.audio}
          </p>
        ) : (
          <p class:list={['msg', m.from === 'ai' ? 'out' : 'in']}>
            {m.from === 'ai' && <span class="sr-only">Agente de IA: </span>}
            {m.from === 'client' && <span class="sr-only">Cliente: </span>}
            {m.text}
          </p>
        ),
      )
    }
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .chat-card {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    background: #efeae2;
    border-radius: 20px;
    overflow: hidden;
    color: #111;
    box-shadow:
      0 30px 70px rgba(0, 0, 0, 0.5),
      0 0 60px rgba(124, 58, 237, 0.25);
  }
  .head {
    background: var(--grad-btn);
    color: #fff;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .av {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    flex: none;
  }
  .who {
    display: flex;
    flex-direction: column;
    font-size: 14px;
    line-height: 1.25;
  }
  .who span {
    font-size: 11px;
    opacity: 0.9;
  }
  .body {
    padding: 18px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 240px;
  }
  .msg {
    max-width: 84%;
    padding: 9px 12px;
    font-size: 14px;
    line-height: 1.45;
    border-radius: 12px;
  }
  .msg.in {
    align-self: flex-start;
    background: #fff;
    border-top-left-radius: 3px;
  }
  .msg.out {
    align-self: flex-end;
    background: #d9fdd3;
    border-top-right-radius: 3px;
  }
  .audio {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #075e54;
    font-weight: 600;
    font-size: 13px;
  }
  .wave {
    width: 60px;
    height: 12px;
    background: repeating-linear-gradient(90deg, #075e54 0 2px, transparent 2px 5px);
    opacity: 0.7;
  }
  figcaption {
    padding: 0 16px 14px;
    font-size: 12px;
    color: #475569;
    text-align: center;
  }
</style>
