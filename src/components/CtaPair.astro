---
// Primary (WhatsApp demo) + secondary (free trial). The final CTA section of
// each page also shows the tertiary booking link.
import Cta from './Cta.astro';
interface Props {
  location: string;
  size?: 'md' | 'lg';
  center?: boolean;
  withBooking?: boolean;
}
const { location, size = 'md', center = false, withBooking = false } = Astro.props;
---

<div class:list={['cta-group', center && 'center']}>
  <div class="btn-row">
    <Cta kind="demo" size={size} location={location} />
    <Cta kind="trial" size={size} location={location} />
  </div>
  {withBooking && <Cta kind="booking" location={location} />}
</div>
