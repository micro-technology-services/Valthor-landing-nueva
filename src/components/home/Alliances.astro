---
import { Image } from 'astro:assets';
import kuad from '../../assets/partners/kuad.png';
import gymflow from '../../assets/partners/gymflow.jpg';
import zeus from '../../assets/partners/zeus.png';
import { rich } from '../../lib/text';
interface Props {
  alliances: any;
}
const { alliances } = Astro.props;
const logos = { kuad, gymflow, zeus } as const;
---

<section class="section lavender alliances" aria-labelledby="alliances-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{alliances.eyebrow}</p>
      <h2 id="alliances-title" class="h2" set:html={rich(alliances.title)} />
      <p class="lead">{alliances.text}</p>
    </div>
    <ul class="grid">
      {
        alliances.items.map((a: any) => {
          const img = logos[a.logo as keyof typeof logos];
          const square = img.width === img.height;
          return (
            <li>
              <a class="card" href={a.href}>
                <span class:list={['logo', square && 'square']}>
                  <Image
                    src={img}
                    alt={a.alt}
                    width={square ? 96 : 220}
                    height={square ? 96 : Math.round((220 * img.height) / img.width)}
                    densities={[1, 2]}
                    loading="lazy"
                  />
                </span>
                <h3>{a.title}</h3>
                <p>{a.text}</p>
                <span class="more">{alliances.linkLabel} →</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: 44px;
  }
  .head .h2 {
    max-width: 900px;
    font-size: 42px;
  }
  .head .lead {
    max-width: 620px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 22px;
  }
  .grid li {
    display: flex;
  }
  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--line-light);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: rgba(124, 58, 237, 0.35);
    box-shadow: 0 18px 40px rgba(124, 58, 237, 0.14);
  }
  .logo {
    height: 96px;
    display: flex;
    align-items: center;
    margin-bottom: 6px;
  }
  .logo img {
    max-height: 64px;
    width: auto;
  }
  .logo.square img {
    max-height: 96px;
    border-radius: 16px;
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.2;
  }
  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .card .more {
    margin-top: auto;
  }
  @media (max-width: 720px) {
    .head .h2 {
      font-size: 28px;
    }
  }
</style>
