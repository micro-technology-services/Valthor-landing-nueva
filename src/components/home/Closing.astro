---
import { Image } from 'astro:assets';
import full from '../../assets/brand/valthor-full.png';
import CtaPair from '../CtaPair.astro';
import { rich } from '../../lib/text';
interface Props {
  closing: any;
}
const { closing } = Astro.props;
---

<section class="section closing" aria-labelledby="closing-title">
  <div class="wrap inner">
    <Image src={full} alt="" width={340} height={Math.round((340 * full.height) / full.width)} densities={[1, 2]} loading="lazy" class="mark" />
    <h2 id="closing-title" class="h2" set:html={rich(closing.title)} />
    <CtaPair location="closing" size="lg" center />
  </div>
</section>

<style>
  .closing {
    background:
      radial-gradient(900px 500px at 50% 0%, rgba(139, 92, 246, 0.3), transparent 60%),
      var(--bg);
    text-align: center;
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }
  .mark {
    width: 300px;
    max-width: 70%;
    height: auto;
    transition:
      transform 0.3s ease,
      filter 0.3s ease;
  }
  .mark:hover {
    transform: scale(1.04);
    filter: drop-shadow(0 0 30px rgba(217, 70, 239, 0.7));
  }
  .h2 {
    font-size: 54px;
    letter-spacing: -0.03em;
    max-width: 820px;
  }
  @media (max-width: 720px) {
    .h2 {
      font-size: 30px;
    }
  }
</style>
