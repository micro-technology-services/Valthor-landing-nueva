---
import { rich } from '../../lib/text';
interface Props {
  roas: any;
}
const { roas } = Astro.props;
const c = roas.cards;
---

<section class="section roas" aria-labelledby="roas-title">
  <div class="wrap row reverse">
    <figure class="gfx" aria-label={c.label}>
      <div class="card sold float">
        <p class="lbl">{c.sold.label}</p>
        <p class="big">{c.sold.value}</p>
        <p class="note">{c.sold.note}</p>
        <div class="bars" aria-hidden="true"><span style="height:60%"></span><span style="height:90%"></span><span
            style="height:45%"></span><span style="height:75%"></span><span style="height:55%"></span></div>
      </div>
      <div class="card ratio float-2">
        <p class="lbl">{c.roas.label}</p>
        <p class="big hl">{c.roas.value}</p>
        <div class="donut" aria-hidden="true"><span></span></div>
      </div>
      <div class="card ads float">
        <p class="lbl">{c.ads.label}</p>
        <ul>
          {
            c.ads.rows.map((r: any) => (
              <li>
                <span>{r.name}</span>
                <strong class:list={[r.warn && 'warn']}>{r.value}</strong>
              </li>
            ))
          }
        </ul>
      </div>
      <figcaption>{c.disclaimer}</figcaption>
    </figure>
    <div class="text">
      <p class="eyebrow">{roas.eyebrow}</p>
      <h2 id="roas-title" class="h2" set:html={rich(roas.title)} />
      <p class="lead">{roas.text}</p>
    </div>
  </div>
</section>

<style>
  .roas {
    background: linear-gradient(180deg, var(--bg-2), var(--bg));
  }
  .reverse {
    flex-wrap: wrap-reverse;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  .gfx {
    position: relative;
    height: 440px;
    max-width: 520px;
  }
  .card {
    position: absolute;
    background: var(--app-bg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 16px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.4);
  }
  .lbl {
    color: var(--on-dark-3);
    font-size: 12px;
    margin-bottom: 6px;
  }
  .big {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    color: #fff;
  }
  .note {
    font-size: 12px;
    color: #34d399;
    margin-top: 2px;
  }
  .sold {
    left: 0;
    top: 20px;
    width: 230px;
  }
  .bars {
    display: flex;
    gap: 4px;
    margin-top: 12px;
    align-items: flex-end;
    height: 34px;
  }
  .bars span {
    flex: 1;
    border-radius: 3px;
    background: rgba(139, 92, 246, 0.45);
  }
  .bars span:nth-child(2) {
    background: var(--accent);
  }
  .bars span:nth-child(4) {
    background: var(--accent2);
  }
  .ratio {
    right: 10px;
    top: 0;
    width: 180px;
  }
  .ratio .big {
    font-size: 34px;
  }
  .donut {
    position: absolute;
    right: 16px;
    top: 16px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: conic-gradient(var(--accent) 0% 65%, var(--accent2) 65% 85%, rgba(255, 255, 255, 0.12) 85% 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .donut span {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--app-bg);
  }
  .ads {
    left: 50px;
    top: 190px;
    width: 300px;
  }
  .ads li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    padding: 8px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ads li strong {
    color: #c4b5fd;
    font-family: var(--font-display);
    white-space: nowrap;
  }
  .ads li strong.warn {
    color: #fbbf24;
    font-family: var(--font-body);
    font-size: 12px;
  }
  figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    font-size: 12px;
    color: var(--on-dark-3);
  }
  @media (max-width: 720px) {
    .gfx {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
      align-items: stretch;
      max-width: 340px;
      margin: 0 auto;
    }
    .card,
    figcaption {
      position: relative;
      inset: auto;
      width: 100%;
      animation: none;
    }
  }
</style>
