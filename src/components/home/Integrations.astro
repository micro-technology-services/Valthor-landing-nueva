---
import { Image } from 'astro:assets';
import { rich } from '../../lib/text';
interface Props {
  integrations: any;
}
const { integrations } = Astro.props;
const icons = import.meta.glob<{ default: ImageMetadata }>('../../assets/integrations/*.{svg,png,webp,jpg}', {
  eager: true,
});
const iconFor = (name: string) => {
  const hit = Object.entries(icons).find(([p]) => p.includes(`/integrations/${name}.`));
  if (!hit) throw new Error(`Integration icon "${name}" not found in src/assets/integrations/`);
  return hit[1].default;
};
---

<section class="section light integrations" aria-labelledby="integrations-title">
  <div class="wrap">
    <h2 id="integrations-title" class="h2" set:html={rich(integrations.title)} />
    <p class="lead">{integrations.text}</p>
    <ul class="chips">
      {
        integrations.items.map((it: any) => {
          const img = it.icon ? iconFor(it.icon) : null;
          const full = it.icon === 'gymflow';
          return (
            <li>
              <span class:list={['chip', full && 'full']} aria-hidden="true">
                {img ? (
                  <Image src={img} alt="" width={full ? 80 : 40} height={full ? 80 : 40} densities={[1, 2]} loading="lazy" />
                ) : (
                  <span class="mono" style={`color:${it.color}`}>
                    {it.monogram}
                  </span>
                )}
              </span>
              <span class="name">{it.name}</span>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .integrations {
    text-align: center;
    border-top: 1px solid var(--line-light);
  }
  .h2 {
    font-size: 44px;
    margin-bottom: 18px;
  }
  .lead {
    max-width: 560px;
    margin: 0 auto 48px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 26px 22px;
    max-width: 900px;
    margin: 0 auto;
  }
  .chips li {
    width: 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .chip {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .chip img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .chip.full {
    background: #fff;
  }
  .chip.full img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    padding: 10px;
  }
  .chips li:hover .chip {
    transform: translateY(-8px) scale(1.08);
    box-shadow:
      0 12px 30px rgba(124, 58, 237, 0.25),
      0 0 0 1px rgba(124, 58, 237, 0.2);
  }
  .mono {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
  }
  .name {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
    line-height: 1.25;
  }
  @media (max-width: 720px) {
    .h2 {
      font-size: 30px;
    }
    .chips {
      gap: 20px 10px;
    }
    .chips li {
      width: 84px;
    }
    .chip {
      width: 66px;
      height: 66px;
    }
    .chip.full img {
      width: 66px;
      height: 66px;
    }
  }
</style>
