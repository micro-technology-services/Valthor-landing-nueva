---
import CtaPair from '../CtaPair.astro';
import { rich } from '../../lib/text';

interface Props {
  hero: any;
}
const { hero } = Astro.props;
const m = hero.mockup;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap copy">
    <p class="badge"><span class="dot" aria-hidden="true"></span>{hero.badge}</p>
    <h1 id="hero-title" set:html={rich(hero.title)} />
    <div class="rule" aria-hidden="true"></div>
    <p class="lead">{hero.lead}</p>
    <CtaPair location="hero" size="lg" center />
    <ul class="trust">
      {hero.trust.map((t: string) => <li>{t}</li>)}
    </ul>
  </div>

  <div class="mock-wrap">
    <figure class="mock" aria-label={m.label}>
      <div class="bar" aria-hidden="true">
        <span class="d r"></span><span class="d y"></span><span class="d g"></span>
        <span class="url">{m.url}</span>
        <span class="tag">{m.tag}</span>
      </div>
      <div class="app">
        <div class="rail" aria-hidden="true">
          <span class="rail-logo"></span>
          <span class="ri on">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg
            >
          </span>
          <span class="ri"
            ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><circle cx="9" cy="7" r="3"></circle><path d="M2 21v-2a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v2"></path></svg
            ></span
          >
          <span class="ri"
            ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><path d="M3 3v18h18"></path><path d="M7 14l4-4 3 3 5-6"></path></svg
            ></span
          >
          <span class="ri"
            ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              ><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg
            ></span
          >
        </div>
        <div class="list">
          <p class="list-title">{m.listTitle}</p>
          <ul>
            {
              m.chats.map((c: any) => (
                <li class:list={['chat', c.active && 'active']}>
                  <span class="av" style={`background:${c.color}`} aria-hidden="true">
                    {c.initials}
                  </span>
                  <span class="who">
                    <span class="nm">{c.name}</span>
                    <span class="pv">{c.preview}</span>
                  </span>
                  {c.status && <span class:list={['st', c.status === 'Humano' ? 'human' : 'sale']}>{c.status}</span>}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="thread">
          <div class="th-head">
            <span class="av" style="background:#047857" aria-hidden="true">{m.thread.initials}</span>
            <span class="who">
              <span class="nm">{m.thread.name}</span>
              <span class="meta">{m.thread.meta}</span>
            </span>
          </div>
          <div class="msgs">
            {
              m.thread.messages.map((msg: any) => (
                <p class:list={['bubble', msg.from === 'ai' ? 'ai' : 'in']}>
                  {msg.text}
                  {msg.meta && <small>{msg.meta}</small>}
                </p>
              ))
            }
            <p class="outcome">{m.thread.outcome}</p>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 150px;
    background:
      radial-gradient(1200px 700px at 70% -10%, rgba(139, 92, 246, 0.28), transparent 60%),
      radial-gradient(900px 600px at 10% 30%, rgba(217, 70, 239, 0.14), transparent 55%),
      var(--bg);
  }
  .glow {
    position: absolute;
    top: -160px;
    left: 50%;
    transform: translateX(-50%);
    width: 680px;
    height: 420px;
    background: radial-gradient(closest-side, rgba(139, 92, 246, 0.4), transparent);
    pointer-events: none;
  }
  .copy {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 8px 16px;
    border: 1px solid rgba(139, 92, 246, 0.45);
    border-radius: 100px;
    background: rgba(139, 92, 246, 0.12);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 28px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent2);
    box-shadow: 0 0 10px var(--accent2);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 1000px;
    text-wrap: balance;
  }
  .rule {
    height: 1px;
    width: 120px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    margin: 30px auto 22px;
  }
  .lead {
    max-width: 680px;
    margin-bottom: 34px;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 0;
    margin-top: 30px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-3);
  }
  .trust li + li::before {
    content: '·';
    margin: 0 12px;
  }

  .mock-wrap {
    position: relative;
    z-index: 2;
    max-width: 1080px;
    margin: 56px auto 0;
    padding: 0 var(--gutter);
  }
  .mock {
    border-radius: 18px 18px 0 0;
    overflow: hidden;
    background: var(--app-panel);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 0;
    box-shadow:
      0 40px 100px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(139, 92, 246, 0.1),
      0 -10px 80px rgba(124, 58, 237, 0.25);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 13px 16px;
    background: var(--app-bar);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 12px;
  }
  .d {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .r {
    background: #ff5f57;
  }
  .y {
    background: #febc2e;
  }
  .g {
    background: #28c840;
  }
  .url {
    margin-left: 12px;
    color: var(--on-dark-3);
    font-weight: 500;
  }
  .tag {
    margin-left: auto;
    color: var(--on-dark-2);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 11px;
  }
  .app {
    display: grid;
    grid-template-columns: 58px 270px 1fr;
    min-height: 400px;
    background: var(--app-bg);
    text-align: left;
  }
  .rail {
    background: var(--app-panel);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    color: rgba(255, 255, 255, 0.45);
  }
  .rail-logo {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--grad);
  }
  .ri {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ri svg {
    width: 16px;
    height: 16px;
  }
  .ri.on {
    background: rgba(139, 92, 246, 0.2);
    color: var(--accent-soft);
  }
  .list {
    background: var(--app-panel);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    padding: 16px 0;
  }
  .list-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    padding: 0 16px 12px;
  }
  .chat {
    display: flex;
    gap: 11px;
    align-items: center;
    padding: 12px 16px;
  }
  .chat.active {
    background: linear-gradient(90deg, rgba(139, 92, 246, 0.18), transparent);
    border-left: 2px solid var(--accent);
    padding-left: 14px;
  }
  .av {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    color: #fff;
  }
  .who {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .nm {
    font-weight: 600;
    font-size: 13px;
  }
  .pv {
    font-size: 12px;
    color: var(--on-dark-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .st {
    margin-left: auto;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 5px;
  }
  .st.sale {
    color: #34d399;
    background: rgba(16, 185, 129, 0.14);
  }
  .st.human {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.14);
  }
  .thread {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .th-head {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .th-head .nm {
    font-size: 15px;
  }
  .meta {
    font-size: 12px;
    color: var(--accent-soft);
    font-weight: 500;
  }
  .msgs {
    flex: 1;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bubble.in {
    background: var(--app-bubble);
    color: rgba(255, 255, 255, 0.92);
    max-width: 70%;
  }
  .bubble.ai {
    max-width: 74%;
  }
  .outcome {
    align-self: center;
    font-size: 11px;
    font-weight: 700;
    color: #34d399;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
    padding: 5px 12px;
    border-radius: 999px;
  }

  @media (max-width: 860px) {
    .app {
      grid-template-columns: 58px 1fr;
    }
    .list {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .hero {
      padding-top: 112px;
    }
    .badge {
      margin-bottom: 20px;
    }
    .trust {
      font-size: 11px;
      letter-spacing: 0.08em;
    }
    .mock-wrap {
      padding: 0 14px;
      margin-top: 40px;
    }
    .app {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .rail {
      display: none;
    }
    .bubble.in,
    .bubble.ai {
      max-width: 88%;
    }
  }
</style>
