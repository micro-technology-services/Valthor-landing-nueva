---
import { rich } from '../../lib/text';
interface Props {
  jobs: any;
}
const { jobs } = Astro.props;
---

<section id="funciones" class="section lavender jobs" aria-labelledby="jobs-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">{jobs.eyebrow}</p>
      <h2 id="jobs-title" class="h2" set:html={rich(jobs.title)} />
    </div>
    <ol class="grid">
      {
        jobs.items.map((j: any, i: number) => {
          const Tag = j.href ? 'a' : 'div';
          return (
            <li>
              <Tag class="card" href={j.href}>
                <span class="num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3>{j.title}</h3>
                <p>{j.text}</p>
                {j.href && (
                  <span class="go" aria-hidden="true">
                    →
                  </span>
                )}
              </Tag>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: 44px;
  }
  .head .h2 {
    max-width: 860px;
    color: var(--ink);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 18px;
  }
  .grid li {
    display: flex;
  }
  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fff;
    border: 1px solid var(--line-light);
    border-radius: 20px;
    padding: 28px 24px;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
    text-decoration: none;
    color: inherit;
    position: relative;
    transition:
      transform 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }
  a.card:hover {
    transform: translateY(-6px);
    border-color: rgba(124, 58, 237, 0.35);
    box-shadow: 0 18px 40px rgba(124, 58, 237, 0.14);
  }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--accent-ink);
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    line-height: 1.15;
    color: var(--ink);
  }
  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .go {
    margin-top: auto;
    color: var(--accent-ink);
    font-weight: 700;
  }
</style>
