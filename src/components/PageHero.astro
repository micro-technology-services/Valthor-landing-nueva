---
// First block of every inner page: breadcrumbs, H1 with the search phrase,
// an answer-first summary (what search engines and AI assistants quote),
// key facts and both CTAs.
import Breadcrumbs from './Breadcrumbs.astro';
import CtaPair from './CtaPair.astro';
interface Props {
  crumbs: { name: string; path: string }[];
  eyebrow: string;
  h1: string;
  intro: string;
  highlights?: string[];
  updated?: string;
}
const { crumbs, eyebrow, h1, intro, highlights = [], updated } = Astro.props;
---

<section class="page-hero" aria-labelledby="page-title">
  <div class="wrap inner">
    <Breadcrumbs items={crumbs} />
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title">{h1}</h1>
    <p class="intro">{intro}</p>
    {
      highlights.length > 0 && (
        <ul class="facts">
          {highlights.map((h) => (
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {h}
            </li>
          ))}
        </ul>
      )
    }
    <CtaPair location="page-hero" size="lg" />
    {updated && <p class="updated">Actualizado: {updated}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 140px 0 80px;
    background:
      radial-gradient(1100px 600px at 75% -10%, rgba(139, 92, 246, 0.28), transparent 60%),
      radial-gradient(800px 500px at 0% 40%, rgba(217, 70, 239, 0.12), transparent 55%),
      var(--bg);
    overflow: hidden;
  }
  .inner {
    max-width: 960px;
    margin-left: max(0px, calc((100% - var(--wrap)) / 2));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 5.2vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .intro {
    font-size: 19px;
    line-height: 1.6;
    color: var(--on-dark-2);
    max-width: 780px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 15px;
    font-weight: 600;
  }
  .facts li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .facts svg {
    color: #34d399;
    flex: none;
  }
  .updated {
    font-size: 13px;
    color: var(--on-dark-3);
  }
  @media (max-width: 720px) {
    .page-hero {
      padding: 104px 0 56px;
    }
    .intro {
      font-size: 17px;
    }
  }
</style>
