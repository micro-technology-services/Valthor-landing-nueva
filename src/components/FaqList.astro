---
// FAQ accordion with native <details>: answers are in the HTML without JS.
interface Props {
  faqs: { id: string; question: string; answer: string }[];
  headingLevel?: 'h2' | 'h3';
  theme?: 'dark' | 'light';
}
const { faqs, headingLevel = 'h3', theme = 'dark' } = Astro.props;
const H = headingLevel;
---

<div class:list={['faq', theme]}>
  {
    faqs.map((f, i) => (
      <details id={`faq-${f.id}`} open={i === 0}>
        <summary>
          <H class="q">{f.question}</H>
          <span class="icon" aria-hidden="true" />
        </summary>
        <p class="a">{f.answer}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  details {
    border-radius: 16px;
    border: 1px solid var(--line-dark);
    background: rgba(255, 255, 255, 0.03);
    transition: border-color 0.25s ease;
  }
  details[open] {
    border-color: rgba(139, 92, 246, 0.45);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    cursor: pointer;
    border-radius: 16px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .q {
    flex: 1;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.3;
  }
  .icon {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(139, 92, 246, 0.18);
    position: relative;
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    background: var(--accent-soft);
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease;
  }
  .icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] .icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  .a {
    padding: 0 22px 22px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--on-dark-2);
    max-width: 760px;
  }
  .light details {
    border-color: var(--line-light);
    background: #fff;
  }
  .light details[open] {
    border-color: rgba(124, 58, 237, 0.4);
  }
  .light .a {
    color: var(--ink-2);
  }
  .light .icon::before,
  .light .icon::after {
    background: var(--accent-ink);
  }
  @media (max-width: 720px) {
    .q {
      font-size: 17px;
    }
    summary {
      padding: 18px;
    }
    .a {
      padding: 0 18px 18px;
      font-size: 15px;
    }
  }
</style>
