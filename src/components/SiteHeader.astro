---
import Logo from './Logo.astro';
import Cta from './Cta.astro';
import { getSite } from '../lib/content';
const { nav, cta } = await getSite();
---

<header class="site-header">
  <nav class="wrap nav" aria-label="Principal">
    <a href="/" class="home"><Logo /><span class="sr-only">, inicio</span></a>
    <ul class="links">
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <div class="actions">
      <a class="login" href={cta.login.href}>{cta.login.label}</a>
      <Cta kind="trial" variant="primary" short location="header" />
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path class="bars" d="M4 7h16M4 12h16M4 17h16" />
          <path class="close" d="M6 6l12 12M18 6 6 18" />
        </svg>
        <span class="sr-only">Menú</span>
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="mobile-menu" data-menu hidden>
    <ul class="wrap">
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</header>

<script>
  // Mobile menu (below 1024 px the nav links are hidden from the bar).
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    btn.addEventListener('click', () => set(menu.hidden));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        set(false);
        btn.focus();
      }
    });
    matchMedia('(min-width: 1025px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style>
  /* Sits over the first section of every page, so the hero glow shows behind it. */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-top: 22px;
    padding-bottom: 22px;
  }
  .home {
    text-decoration: none;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  .links {
    display: flex;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
  }
  .links a {
    color: var(--on-dark-2);
    text-decoration: none;
    padding: 10px 0;
  }
  .links a:hover {
    color: #fff;
  }
  .actions {
    margin-left: auto;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  /* Existing customers come to the site to log in: same URL as the trial. */
  .login {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 11px;
    color: var(--on-dark-2);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }
  .login:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  .actions :global(.btn) {
    min-height: 44px;
    padding: 11px 18px;
    font-size: 15px;
    border-radius: 11px;
  }
  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(20, 14, 38, 0.6);
    color: #fff;
    cursor: pointer;
  }
  .menu-btn:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .menu-btn .close,
  .menu-btn[aria-expanded='true'] .bars {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .close {
    display: inline;
  }
  .mobile-menu {
    background: rgba(14, 10, 26, 0.97);
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
    padding: 8px 0 14px;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu a {
    display: flex;
    align-items: center;
    min-height: 48px;
    color: var(--on-dark);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--line-dark);
  }
  .mobile-menu li:last-child a {
    border-bottom: 0;
  }
  .mobile-menu a:hover {
    color: var(--accent-soft);
  }
  @media (max-width: 1024px) {
    .links {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 720px) {
    .nav {
      gap: 12px;
      padding-top: 14px;
      padding-bottom: 14px;
    }
    .actions {
      gap: 4px;
    }
    .actions :global(.btn) {
      padding: 10px 14px;
      font-size: 14px;
      white-space: nowrap;
    }
    .login {
      font-size: 14px;
      padding: 0 10px;
    }
  }
  /* Narrow phones: keep only the logo mark, the name stays for screen readers. */
  @media (max-width: 440px) {
    .home :global(.words) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
