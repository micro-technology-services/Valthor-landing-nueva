---
import Logo from './Logo.astro';
import Cta from './Cta.astro';
import { getSite } from '../lib/content';
const { nav, cta } = await getSite();
---

<header class="site-header">
  <nav class="wrap nav" aria-label="Principal">
    <a href="/" class="home"><Logo /><span class="sr-only">, inicio</span></a>
    <ul class="links">
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <div class="actions">
      <a class="login" href={cta.login.href}>{cta.login.label}</a>
      <Cta kind="trial" variant="primary" short location="header" />
    </div>
  </nav>
</header>

<style>
  /* Sits over the first section of every page, so the hero glow shows behind it. */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-top: 22px;
    padding-bottom: 22px;
  }
  .home {
    text-decoration: none;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  .links {
    display: flex;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
  }
  .links a {
    color: var(--on-dark-2);
    text-decoration: none;
    padding: 10px 0;
  }
  .links a:hover {
    color: #fff;
  }
  .actions {
    margin-left: auto;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  /* Existing customers come to the site to log in: same URL as the trial. */
  .login {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 11px;
    color: var(--on-dark-2);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }
  .login:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  .actions :global(.btn) {
    min-height: 44px;
    padding: 11px 18px;
    font-size: 15px;
    border-radius: 11px;
  }
  @media (max-width: 1024px) {
    .links {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .nav {
      gap: 12px;
      padding-top: 14px;
      padding-bottom: 14px;
    }
    .actions {
      gap: 4px;
    }
    .actions :global(.btn) {
      padding: 10px 14px;
      font-size: 14px;
      white-space: nowrap;
    }
    .login {
      font-size: 14px;
      padding: 0 10px;
    }
  }
  /* Narrow phones: keep only the logo mark, the name stays for screen readers. */
  @media (max-width: 440px) {
    .home :global(.words) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
