---
// The 7-block template for function, industry and alliance pages:
// 1 H1 + summary · 2 pain · 3 what Valthor does · 4 example conversation
// 5 FAQs · 6 CTAs · 7 related links.
import { Image } from 'astro:assets';
import kuad from '../../assets/partners/kuad.png';
import gymflow from '../../assets/partners/gymflow.jpg';
import zeus from '../../assets/partners/zeus.png';
import PageHero from '../PageHero.astro';
import ChatCard from '../ChatCard.astro';
import FaqList from '../FaqList.astro';
import CtaBand from '../CtaBand.astro';
import RelatedLinks from '../RelatedLinks.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'landings'>;
  crumbs: { name: string; path: string }[];
}
const { entry, crumbs } = Astro.props;
const d = entry.data;
const logos = { kuad, gymflow, zeus } as const;
const faqs = d.faqs.map((f, i) => ({ id: `${entry.id.replace(/\//g, '-')}-${i + 1}`, ...f }));
const hasBody = Boolean(entry.body?.trim());
---

<PageHero crumbs={crumbs} eyebrow={d.eyebrow} h1={d.h1} intro={d.intro} highlights={d.highlights} updated={d.updated} />

<section class="section pain" aria-labelledby="pain-title">
  <div class="wrap row">
    <div>
      <h2 id="pain-title" class="h2">{d.pain.title}</h2>
      <p class="lead pain-text">{d.pain.text}</p>
    </div>
    <ul class="pains">
      {
        d.pain.items.map((p) => (
          <li>
            <span class="x" aria-hidden="true">
              ×
            </span>
            {p}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section lavender features" aria-labelledby="features-title">
  <div class="wrap">
    <div class="head">
      <h2 id="features-title" class="h2">{d.features.title}</h2>
      {d.features.text && <p class="lead">{d.features.text}</p>}
    </div>
    <ul class:list={['grid', d.kind === 'alianza' && 'partners']}>
      {
        d.features.items.map((f) => {
          const logo = f.logo ? logos[f.logo] : null;
          const square = logo ? logo.width === logo.height : false;
          return (
            <li id={f.id} class="card">
              {logo && (
                <span class:list={['logo', square && 'square']}>
                  <Image
                    src={logo}
                    alt={`Logo de ${f.title.split(':')[0]}`}
                    width={square ? 88 : 200}
                    height={square ? 88 : Math.round((200 * logo.height) / logo.width)}
                    densities={[1, 2]}
                    loading="lazy"
                  />
                </span>
              )}
              <h3>{f.title}</h3>
              <p>{f.text}</p>
              {f.note && <span class="note">{f.note}</span>}
              {f.website && (
                <a class="more site" href={f.website} target="_blank" rel="noopener">
                  Visitar el sitio de {f.title.split(':')[0]} <span aria-hidden="true">↗</span>
                </a>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

{
  hasBody && (
    <section class="section how" aria-label="Cómo funciona">
      <div class="wrap prose">
        <slot />
      </div>
    </section>
  )
}

<section class="section convo" aria-labelledby="convo-title">
  <div class="wrap row">
    <div class="convo-text">
      <h2 id="convo-title" class="h2">{d.conversation.title}</h2>
      <p class="lead">{d.conversation.text}</p>
    </div>
    <ChatCard label={`Conversación de ejemplo: ${d.conversation.title}`} business={d.conversation.business} messages={d.conversation.messages} />
  </div>
</section>

<section class="section faq-sec" aria-labelledby="faq-title">
  <div class="wrap faq-inner">
    <h2 id="faq-title" class="h2">Preguntas frecuentes</h2>
    <FaqList faqs={faqs} />
  </div>
</section>

<CtaBand title={d.cta.title} text={d.cta.text} location={`landing-${entry.id}`} />

<RelatedLinks items={d.related} />

<style>
  .pain {
    background: linear-gradient(180deg, var(--bg), var(--bg-2));
  }
  .pain-text {
    margin-top: 18px;
  }
  .pains {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pains li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 18px;
    line-height: 1.5;
    color: var(--on-dark-2);
  }
  .x {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: rgba(139, 92, 246, 0.22);
    color: #f0abfc;
    font-weight: 700;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-bottom: 40px;
  }
  .head .lead {
    max-width: 640px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 18px;
  }
  .card {
    background: #fff;
    border: 1px solid var(--line-light);
    border-radius: 20px;
    padding: 28px;
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    gap: 10px;
    scroll-margin-top: 24px;
  }
  .card:target {
    border-color: var(--accent-ink);
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.2);
  }
  .card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.2;
  }
  .card p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .note {
    align-self: flex-start;
    margin-top: auto;
    font-size: 12px;
    font-weight: 700;
    color: var(--accent-ink);
    background: rgba(124, 58, 237, 0.1);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .site {
    margin-top: auto;
  }
  .logo {
    height: 88px;
    display: flex;
    align-items: center;
  }
  .logo img {
    max-height: 58px;
    width: auto;
  }
  .logo.square img {
    max-height: 88px;
    border-radius: 16px;
  }
  .how {
    background: var(--bg);
  }
  .prose {
    max-width: 820px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--on-dark-2);
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    color: #fff;
    font-size: 32px;
    margin-bottom: 18px;
  }
  .prose :global(ol) {
    list-style: decimal;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .prose :global(strong) {
    color: #fff;
  }
  .convo {
    background:
      radial-gradient(700px 500px at 100% 50%, rgba(217, 70, 239, 0.14), transparent 65%),
      var(--bg);
  }
  .convo-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .faq-sec {
    background: var(--bg-2);
  }
  .faq-inner {
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  @media (max-width: 720px) {
    .pains li {
      font-size: 16px;
    }
    .prose :global(h2) {
      font-size: 26px;
    }
  }
</style>
